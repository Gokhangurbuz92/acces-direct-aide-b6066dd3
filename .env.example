# ============================================
# FICHIER .env.example - TEMPLATE
# ============================================
# Ce fichier sert de template pour la configuration des variables d'environnement
# Copiez ce fichier vers .env.local et remplissez avec vos vraies valeurs
# 
# Commande: cp .env.example .env.local

# ============================================
# DATABASE (OBLIGATOIRE)
# ============================================
# URL de connexion PostgreSQL (poolée, utilisée par Prisma)
# NOTE: placeholder intentionally omits the password. Your real URL will include credentials.
DATABASE_URL="postgresql://user@host:5432/db?schema=public"

# URL de connexion PostgreSQL (TEST UNIQUEMENT, DB dédiée locale)
# Utilisée par `npm test` pour reset + migrations + seed de manière déterministe.
# NOTE: placeholder intentionally masks the password part.
DATABASE_URL_TEST="postgresql://user:***@localhost:5432/acces_direct_aide_test?schema=public"

# URL de connexion PostgreSQL (non-poolée, pour migrations)
POSTGRES_URL_NON_POOLING="postgresql://user@host:5432/db?schema=public"

# Alias Prisma (même valeur que DATABASE_URL)
POSTGRES_PRISMA_URL="postgresql://user@host:5432/db?schema=public"

# Alias unpooled (même valeur que POSTGRES_URL_NON_POOLING)
DATABASE_URL_UNPOOLED="postgresql://user@host:5432/db?schema=public"

# ============================================
# SECURITY & AUTHENTICATION (OBLIGATOIRE)
# ============================================

# JWT Secret (minimum 32 caractères, utilisé pour signer les tokens)
# Générer avec: openssl rand -hex 32
JWT_SECRET="super-secret-jwt-key-minimum-32-chars"

# ADA Encryption Key (64 caractères hex = 32 bytes pour AES-256-GCM)
# Générer avec: openssl rand -hex 32
ADA_ENCRYPTION_KEY="32-byte-hex-string-for-aes-256-gcm"

# Cron Secret (pour sécuriser les endpoints cron)
# Générer avec: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# ============================================
# UPSTASH KV / REDIS (OBLIGATOIRE pour rate limiting)
# ============================================

# URLs REST API Upstash KV
KV_REST_API_URL="https://your-instance.upstash.io"
KV_REST_API_TOKEN="your-upstash-token"

# Alias Upstash (mêmes valeurs que ci-dessus)
UPSTASH_KV_KV_REST_API_URL="https://your-instance.upstash.io"
UPSTASH_KV_KV_REST_API_TOKEN="your-upstash-token"

# Token read-only (optionnel, pour les opérations de lecture uniquement)
UPSTASH_KV_KV_REST_API_READ_ONLY_TOKEN="your-readonly-token"

# URLs Redis (format rediss://)
# NOTE: placeholder intentionally omits the password part.
UPSTASH_KV_REDIS_URL="rediss://default@your-instance.upstash.io:6379"
UPSTASH_KV_KV_URL="rediss://default@your-instance.upstash.io:6379"

# ============================================
# SENTRY - MONITORING (RECOMMANDÉ)
# ============================================

# DSN Sentry (pour le frontend Vite)
VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# DSN Sentry (pour le backend Node, optionnel)
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Variables Sentry pour le build (optionnel, pour upload des sourcemaps)
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"
# SENTRY_AUTH_TOKEN="your-auth-token"

# ============================================
# STORAGE S3 (OPTIONNEL)
# ============================================
#
# Utilisé pour les uploads/downloads (Backblaze B2 S3, Cloudflare R2, MinIO, etc.)
# Ne pas activer si vous n'utilisez pas la fonctionnalité.
#
# STORAGE_ENDPOINT="https://s3.your-region.example.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="your-bucket"
# STORAGE_ACCESS_KEY_ID="your-access-key-id"
# STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"

# ============================================
# AI (OPTIONNEL)
# ============================================
#
# Utilisé pour Gemini (assistant + embeddings) si vous activez les features IA.
# GEMINI_API_KEY (ou GOOGLE_API_KEY alias)
#
# GEMINI_API_KEY="your-gemini-api-key"
# GOOGLE_API_KEY="your-google-api-key"

# ============================================
# SITE CONFIGURATION (RECOMMANDÉ)
# ============================================

# URL de base du site (pour les liens canoniques, sitemap, robots.txt)
PUBLIC_BASE_URL="https://www.accesdirectaide.fr"

# ============================================
# ADMIN & AUTOMATION (OBLIGATOIRE)
# ============================================

# Token admin pour l'API (pour les opérations d'administration)
# Utilisé pour authentifier les requêtes d'administration
# Générer avec: openssl rand -base64 48
ADMIN_TOKEN="your-admin-token-for-api-auth"

# Identifiants admin (utilisés pour le login admin sur /admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Secret pour bypass automation (pour tests et automation)
# Utilisé pour contourner certaines vérifications dans les scripts automatisés
# Générer avec: openssl rand -hex 32
BYPASS_SECRET="optional-automation-bypass-secret"

# Debug token (optionnel) pour endpoints diagnostics protégés (ex: /api/version)
# DEBUG_TOKEN="your-debug-token"

# ============================================
# DEVELOPMENT FLAGS (NE PAS UTILISER EN PRODUCTION)
# ============================================

# Activer le login dev (UNIQUEMENT en développement local)
VITE_DEV_LOGIN_ENABLED="false"

# Activer les endpoints diagnostics publics (ex: /__sentry_test)
VITE_PUBLIC_DIAGNOSTICS="false"

# Activer les logs analytics client (console)
VITE_PUBLIC_ENABLE_LOGGING="false"

# Activer les outils de dev (UNIQUEMENT en développement local)
ALLOW_DEV_TOOLS="false"

# Niveau de logs serveur (optionnel): debug|info|warn|error
LOG_LEVEL="info"

# Env de déploiement (optionnel, Vercel injecte généralement ces valeurs)
# VITE_DEPLOY_ENV="production"
# VITE_VERCEL_ENV="production"
# VITE_GIT_COMMIT_SHA="dev"

# URL base applicative (optionnel, sinon PUBLIC_BASE_URL)
# APP_BASE_URL="https://www.accesdirectaide.fr"

# Activer les headers debug cache (optionnel)
# CACHE_DEBUG_HEADERS="false"

# ============================================
# NOTES IMPORTANTES
# ============================================
#
# 1. GÉNÉRATION DES SECRETS:
#    Utilisez des outils cryptographiques pour générer des secrets forts:
#    - openssl rand -hex 32  (pour JWT_SECRET, ADA_ENCRYPTION_KEY, CRON_SECRET)
#    - node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. NEON DATABASE:
#    Pour obtenir vos URLs PostgreSQL:
#    - Connectez-vous à https://console.neon.tech
#    - Sélectionnez votre projet
#    - Allez dans "Connection Details"
#    - Copiez les URLs (pooled et direct)
#    - ⚠️ ATTENTION: Vérifiez qu'il n'y a PAS d'espace après le mot de passe
#
# 3. UPSTASH KV:
#    Pour obtenir vos credentials Upstash:
#    - Connectez-vous à https://console.upstash.com
#    - Sélectionnez votre database Redis
#    - Copiez les URLs REST API et Redis
#
# 4. SENTRY:
#    Pour obtenir votre DSN Sentry:
#    - Connectez-vous à https://sentry.io
#    - Sélectionnez votre projet
#    - Allez dans Settings → Client Keys (DSN)
#    - Copiez le DSN
#
# 5. VERCEL:
#    Sur Vercel, configurez ces variables dans:
#    Settings → Environment Variables
#    
#    Sélectionnez les environnements appropriés:
#    - Production: pour le déploiement main
#    - Preview: pour les branches de preview
#    - Development: pour le développement local (optionnel)
#
# 6. SÉCURITÉ:
#    - Ne jamais commiter .env.local (déjà dans .gitignore)
#    - Utiliser des secrets différents pour prod/preview/dev
#    - Régénérer les secrets si exposés
#    - Ne jamais partager les secrets dans les issues/PR
#
# 7. VARIABLES MANQUANTES:
#    Si une variable est manquante, le projet peut:
#    - Ne pas démarrer (DATABASE_URL, JWT_SECRET, ADA_ENCRYPTION_KEY)
#    - Fonctionner en mode dégradé (KV_REST_API_* → rate limiting désactivé)
#    - Ne pas envoyer d'erreurs (VITE_SENTRY_DSN → monitoring désactivé)
#
# ============================================
