# Database (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Security
JWT_SECRET="super-secret-jwt-key-minimum-32-chars"
ENCRYPTION_KEY="32-byte-hex-string-for-aes-256-gcm"

# Storage
STORAGE_BUCKET="optional-bucket-name" # If empty, uses local ./uploads

# Vercel KV (Rate Limiting)
KV_REST_API_URL="https://..."
KV_REST_API_TOKEN="..."

# Development Flags (Do NOT use in Production)
# VITE_DEV_LOGIN_ENABLED="true"
# ALLOW_DEV_TOOLS="true"
