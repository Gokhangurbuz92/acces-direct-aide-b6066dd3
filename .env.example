# .env.example (NO SECRETS)
#
# Template for local development. Copy to `.env.local` and fill values.
# - Never commit `.env.local`.
# - Never put server secrets in `VITE_*`.
#
# See: docs/ENVIRONMENT.md

# ----------------------------
# DB (Server)
# ----------------------------
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
DATABASE_URL_UNPOOLED=

# Test DB (used by `npm test`)
DATABASE_URL_TEST=

# ----------------------------
# Auth / Security (Server)
# ----------------------------
JWT_SECRET=
ADA_ENCRYPTION_KEY=
ADMIN_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CRON_SECRET=
CRON_ACTUALITES_STALE_MINUTES=
CRON_ACTUALITES_FAIL_MINUTES=
DATA_AIDES_STALE_DAYS=
DATA_DEMARCHES_STALE_DAYS=
DATA_STRUCTURES_STALE_DAYS=
DATA_REVIEW_SCAN_LIMIT_PER_TYPE=
INGESTION_PARSER_VERSION=
INGESTION_DRY_RUN=
INGESTION_MAX_ITEMS_PER_RUN=
BYPASS_SECRET=

# ----------------------------
# Upstash KV (Server) - canonical + aliases supported
# ----------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Common Upstash aliases (optional)
UPSTASH_KV_REST_API_URL=
UPSTASH_KV_REST_API_TOKEN=

# Legacy aliases (optional)
UPSTASH_KV_KV_REST_API_URL=
UPSTASH_KV_KV_REST_API_TOKEN=

# ----------------------------
# Storage (Server)
# ----------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ----------------------------
# Sentry (Server + Client)
# ----------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# DevOps only (do not use at runtime)
SENTRY_AUTH_TOKEN=

# ----------------------------
# AI (Server)
# ----------------------------
GEMINI_API_KEY=

# ----------------------------
# Public site config
# ----------------------------
PUBLIC_BASE_URL=

# ----------------------------
# Dev flags (Local only)
# ----------------------------
LOG_LEVEL=
ALLOW_DEV_TOOLS=
VITE_DEV_LOGIN_ENABLED=
VITE_PUBLIC_DIAGNOSTICS=
VITE_PUBLIC_ENABLE_LOGGING=
VITE_DEPLOY_ENV=
VITE_VERCEL_ENV=
VITE_GIT_COMMIT_SHA=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
APP_BASE_URL=
DEBUG_TOKEN=
