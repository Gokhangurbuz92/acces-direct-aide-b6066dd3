# Database (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Security
JWT_SECRET="super-secret-jwt-key-minimum-32-chars"
ADA_ENCRYPTION_KEY="32-byte-hex-string-for-aes-256-gcm"
ADMIN_TOKEN="your-admin-token-for-api-auth"
CRON_SECRET="your-cron-secret"

# Vercel Automation (Optional)
BYPASS_SECRET="optional-automation-bypass-secret"

# Site Config
PUBLIC_BASE_URL="https://www.accesdirectaide.fr"

# Vercel KV (Rate Limiting)
KV_REST_API_URL="https://..."
KV_REST_API_TOKEN="..."

# Cloudflare R2 Storage (Optional - Persistent File Storage)
# If not configured, falls back to ephemeral /tmp storage
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Development Flags (Do NOT use in Production)
VITE_DEV_LOGIN_ENABLED="false"
ALLOW_DEV_TOOLS="false"
