# Database (Prisma)
# Local Docker URL: postgresql://user:pass@localhost:5432/acces_direct_aide?schema=public
DATABASE_URL="postgresql://user:pass@localhost:5432/acces_direct_aide?schema=public"

# Security
JWT_SECRET="super-secret-jwt-key-minimum-32-chars"
ADA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ADMIN_TOKEN="your-admin-token-for-api-auth"
CRON_SECRET="your-cron-secret"

# Vercel Automation (Optional)
BYPASS_SECRET="optional-automation-bypass-secret"

# Site Config
PUBLIC_BASE_URL="https://www.accesdirectaide.fr"

# Vercel KV (Rate Limiting)
KV_REST_API_URL="https://..."
KV_REST_API_TOKEN="..."

# Development Flags (Do NOT use in Production)
VITE_DEV_LOGIN_ENABLED="false"
ALLOW_DEV_TOOLS="false"
