# .env.example (NO SECRETS)
#
# Template for local development. Copy to `.env.local` and fill values.
# - Never commit `.env.local`.
# - Never put server secrets in `VITE_*`.
#
# See: docs/ENVIRONMENT.md

# ----------------------------
# DB (Server)
# ----------------------------
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
DATABASE_URL_UNPOOLED=

# Test DB (used by `npm test`)
DATABASE_URL_TEST=

# ----------------------------
# Auth / Security (Server)
# ----------------------------
JWT_SECRET=
AUTH_MODE=
AUTH_SECRET=
AUTH_JWT_SECRET=
AUTH_MAGICLINK_ENABLED=
MAILER_PROVIDER=
MAILER_FROM=
MAILER_API_KEY=
ADA_ENCRYPTION_KEY=
ADMIN_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CRON_SECRET=
CRON_ACTUALITES_STALE_MINUTES=
CRON_ACTUALITES_FAIL_MINUTES=
DATA_AIDES_STALE_DAYS=
DATA_DEMARCHES_STALE_DAYS=
DATA_STRUCTURES_STALE_DAYS=
DATA_REVIEW_SCAN_LIMIT_PER_TYPE=
DATA_REVIEW_SCAN_CRON_LIMIT_PER_TYPE=
DATA_REVIEW_SCAN_CRON_ENABLED=
INGESTION_PARSER_VERSION=
INGESTION_DRY_RUN=
INGESTION_MAX_ITEMS_PER_RUN=
MONITOR_DQ_OPEN_TOTAL_MAX=
MONITOR_DQ_OPEN_P0_MAX=
MONITOR_INGEST_FRESHNESS_MAX_AGE_HOURS=
PRO_RDV_RATE_LIMIT_READ_PER_MIN=
PRO_RDV_RATE_LIMIT_WRITE_PER_MIN=
PRO_RDV_RATE_LIMIT_WRITE_PER_DAY=
BYPASS_SECRET=

# ----------------------------
# Upstash KV (Server) - canonical + aliases supported
# ----------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Common Upstash aliases (optional)
UPSTASH_KV_REST_API_URL=
UPSTASH_KV_REST_API_TOKEN=

# Legacy aliases (optional)
UPSTASH_KV_KV_REST_API_URL=
UPSTASH_KV_KV_REST_API_TOKEN=

# ----------------------------
# Storage (Server)
# ----------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ----------------------------
# Sentry (Server + Client)
# ----------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# DevOps only (do not use at runtime)
SENTRY_AUTH_TOKEN=

# ----------------------------
# AI (Server)
# ----------------------------
GEMINI_API_KEY=

# ----------------------------
# Data Sources — Architecture Data Universelle (Server)
# ----------------------------
FINESS_DATASET_URL=https://www.data.gouv.fr/fr/datasets/r/2ce43ade-8d2c-4d1d-81da-ca06c82abc68
RNA_API_BASE_URL=https://entreprise.data.gouv.fr/api/rna/v1
FINESS_DEPARTMENTS=67,68
RNA_DEPARTMENTS=67,68

# ----------------------------
# OpenFisca (Server)
# ----------------------------
OPENFISCA_API_URL=http://localhost:2000
OPENFISCA_BASE_URL=https://api.fr.openfisca.org/latest
OPENFISCA_TIMEOUT_MS=5000
OPENFISCA_ENABLE_TRACE=false

# ----------------------------
# Public site config
# ----------------------------
PUBLIC_BASE_URL=
# Front-end API base URL (leave empty for same-origin, the default on Vercel)
VITE_API_BASE_URL=

# ----------------------------
# Démarches Simplifiées (Phase 2b — désactivé par défaut)
# ----------------------------
DS_API_URL=https://www.demarches-simplifiees.fr/api/v2/graphql
ENABLE_DS_INGESTION=false

# ----------------------------
# Dev flags (Local only)
# ----------------------------
LOG_LEVEL=
ALLOW_DEV_TOOLS=
VITE_DEV_LOGIN_ENABLED=
VITE_PUBLIC_DIAGNOSTICS=
VITE_PUBLIC_ENABLE_LOGGING=
VITE_DEPLOY_ENV=
VITE_VERCEL_ENV=
VITE_GIT_COMMIT_SHA=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
APP_BASE_URL=
DEBUG_TOKEN=

# ----------------------------
# Feature Flags (Phase 4)
# ----------------------------
ENABLE_AI_AGENT=false
ENABLE_RAG=false
ENABLE_OPENFISCA=true
ENABLE_CACHE=true
MAINTENANCE_MODE=false
ENABLE_AUDIT_LOG=false

# ----------------------------
# Production Deployment (Phase 4)
# ----------------------------
DOMAIN_NAME=aide.votre-domaine.fr
SSL_EMAIL=admin@votre-domaine.fr
POSTGRES_USER=ada_prod
POSTGRES_PASSWORD=
POSTGRES_DB=acces_direct_aide
