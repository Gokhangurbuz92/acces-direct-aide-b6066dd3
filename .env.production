# Production environment variables
# ⚠️ All sensitive values are set in Vercel Environment Variables dashboard.
# This file should NEVER contain real secrets — only non-sensitive defaults.

# ── Auth (secrets on Vercel only) ──
ADA_ENCRYPTION_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_TOKEN=""
BYPASS_SECRET=""
CRON_SECRET=""
JWT_CITIZEN_SECRET=""
JWT_PRO_SECRET=""
JWT_SECRET=""

# ── Database (secrets on Vercel only) ──
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# ── AI / APIs (secrets on Vercel only) ──
GEMINI_API_KEY=""
AIDES_TERRITOIRES_API_KEY=""

# ── Email (secrets on Vercel only) ──
MAILER_API_KEY=""
MAILER_FROM="noreply@accesdirectaide.fr"
MAILER_PROVIDER="mailjet"

# ── Monitoring (secrets on Vercel only) ──
SENTRY_AUTH_TOKEN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
VITE_SENTRY_DSN=""

# ── Cache / Redis (secrets on Vercel only) ──
KV_REST_API_TOKEN=""
KV_REST_API_URL=""
UPSTASH_KV_KV_REST_API_TOKEN=""
UPSTASH_KV_KV_REST_API_URL=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""

# ── External Services (secrets on Vercel only) ──
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REDIRECT_URI="https://www.accesdirectaide.fr/api/auth/callback/outlook"
TWILIO_AUTH_TOKEN=""
TWILIO_SID=""
VITE_OUTLOOK_CLIENT_ID=""

# ── OpenFisca (non-sensitive, public API) ──
OPENFISCA_BASE_URL="https://api.fr.openfisca.org/latest"
OPENFISCA_ENABLE_TRACE="false"
OPENFISCA_TIMEOUT_MS="4000"

# ── Build flags (non-sensitive) ──
ENABLE_DS_INGESTION="false"
NX_DAEMON="false"
VERCEL="1"
VERCEL_ENV="production"
VERCEL_TARGET_ENV="production"
