# Phase 1: Repo Hygiene
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Variables
.env
.env.local
.env.*
!.env.example
!.env.template

# Next.js / Vercel
.vercel
dist/sitemap.xml

# Python / Virtualenv
venv/
__pycache__/
*.pyc

# Testing & Artifacts
test-results/
playwright-report/
coverage/
cookies*.txt
test-img*.jpg
test-img*

# Local Storage (Mock)
uploads_mock/
api/_utils/build-info.js

# Lint outputs
lint_output*.txt
lint_final.txt

# Generated build info
.blackboxcli/

# Documentation with sensitive data (should be regenerated without secrets)
CONFIGURATION_COMPLETE.md
DIAGNOSTIC_DB_RESULTS.md
LIRE_MOI_CONFIGURATION.md
RAPPORT_CONFIGURATION_ENV.md
RAPPORT_DIAGNOSTIC_FINAL.md
RESUME_FINAL_ENV.md
SYNTHESE_TRAVAIL_EFFECTUE.md
VERCEL_ENV_SETUP.md
DEPLOYMENT_FIX_SUMMARY.md
COMMIT_MESSAGE.txt

# Scripts with hardcoded credentials (use env vars instead)
scripts/test-db-simple.cjs
scripts/apply-search-vector-migration.cjs
scripts/check-db-columns.cjs
scripts/check-db-extensions.cjs

# Any file containing credentials or secrets
*_CREDENTIALS.md
*_SECRETS.md
.env*.local
!docs/ROTATE_SECRETS.md
