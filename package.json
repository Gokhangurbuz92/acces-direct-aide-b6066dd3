{
  "name": "acces-direct-aide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "db:baseline:rdv": "node scripts/db-baseline-rdv.mjs",
    "db:seed": "prisma db seed",
    "doctor": "node scripts/doctor-env.mjs",
    "postinstall": "prisma generate && node scripts/generate-build-info.js",
    "lint": "eslint .",
    "lint:strict": "eslint . --config eslint.strict.config.js",
    "lint:strict:baseline": "node scripts/lint-strict-baseline.mjs",
    "lint:strict:baseline:update": "node scripts/lint-strict-baseline.mjs --update",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit --pretty false",
    "typecheck:strict:baseline": "node scripts/typecheck-strict-baseline.mjs",
    "typecheck:strict:baseline:update": "node scripts/typecheck-strict-baseline.mjs --update",
    "test": "node scripts/test-run.mjs",
    "test:api": "node scripts/test-run.mjs tests/integration",
    "test:repeat": "node scripts/test-repeat.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "cross-env TEST_A11Y=1 playwright test --reporter=html",
    "audit-a11y": "npx playwright test e2e/accessibility.spec.js",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "smoke:seo:prod": "node scripts/seo-smoke.mjs",
    "smoke:obs:prod": "node scripts/obs-smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:design-system",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "test-storybook:run": "test-storybook --url http://127.0.0.1:6006 --config-dir .storybook",
    "storybook:ci": "storybook dev -p 6006 --ci --quiet",
    "test-storybook": "start-server-and-test storybook:ci http://127.0.0.1:6006 test-storybook:run",
    "guard:prisma": "node scripts/guard-prisma.js",
    "preview": "vite preview",
    "diagnostic": "node scripts/diagnostic-env.js",
    "env:check": "node scripts/env-check.mjs",
    "test:db:prod": "node scripts/test-db-production.cjs",
    "test:db:dev": "node scripts/test-db-development.cjs",
    "verify:env": "node scripts/verify-env-consistency.cjs",
    "security:secrets": "node scripts/security-secrets-scan.mjs",
    "security:scan": "npm run security:secrets",
    "security:scan:git": "gitleaks detect --redact --source .",
    "secrets:scan": "npm run security:scan",
    "secrets:scan:git": "npm run security:scan:git",
    "vercel:env:check": "node scripts/vercel-env-sync.mjs",
    "preflight": "npm ci && npm run lint && npm run typecheck && npm test && npm run build",
    "lint:design-system": "node scripts/lint-design-system.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:admin": "docker compose --profile admin up -d",
    "audit": "node scripts/system-audit.js"
  },
