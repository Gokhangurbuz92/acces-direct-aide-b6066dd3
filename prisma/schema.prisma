generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SourceDocument {
  id           String   @id @default(uuid())
  source_url   String?
  fetched_at   DateTime @default(now())
  content_hash String?
  raw_content  String?
  metadata     Json?

  aides       Aide[]
  structures  Structure[]
  dispositifs Dispositif[]
  demarches   Demarche[]
  actualites  Actualite[]
}

model Aide {
  id                    String          @id @default(uuid())
  slug                  String?         @unique
  titre                 String
  categorie             String?
  est_urgent            Boolean         @default(false)
  territoires           String[]
  date_verification     DateTime?
  delai_indicatif       String?
  cest_quoi             String?
  pour_qui              String?
  ce_que_ca_aide        String?
  documents_necessaires String[]
  etapes                Json?
  ou_demander           String?
  lien_demande          String?
  updatedAt             DateTime        @updatedAt
  statut                String          @default("brouillon")
  updatedBy             String?
  quality_score         Int             @default(0)
  commentaire_statut    String?
  published_at          DateTime?
  mots_cles             String[]
  summary_falc          String?
  audiences             String[]
  conditions_falc       String?
  departements          String[]
  montant_falc          String?
  situations_vie        String[]
  structures_links      String[]
  categoryId            String?
  providerName          String?
  providerType          String?
  sourceId              String?
  source_name           String?
  source_url            String?
  category              AidCategory?    @relation(fields: [categoryId], references: [id])
  source                AidSource?      @relation(fields: [sourceId], references: [id])
  situations            LifeSituation[] @relation("AideToLifeSituation")
  aidSituations         AidSituation[]

  // AI Foundation Fields (P0/P1)
  title         String?
  description   String?
  content       String?
  category_code AidCategoryCode              @default(AUTRE)
  status_code   AidStatus                    @default(DRAFT)
  eligibility   Json?
  financials    Json?
  citations     Json?
  qa_score      Int                          @default(0)
  qa_report     Json?
  source_org    String?
  source_hash   String?
  last_checked  DateTime?
  geo_scope     String?
  embedding     Unsupported("vector(3072)")?
  ts_content    Unsupported("tsvector")?

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String? // NATIONAL | REGIONAL | DEPARTMENTAL | COMMUNAL
  region_codes     String[] // For REGIONAL scope
  department_codes String[] // For DEPARTMENTAL scope
  insee_codes      String[] // For COMMUNAL scope
  content_hash     String?

  // New Standard Fields (Lot 9a)
  theme                String?
  sub_theme            String?
  apply_url            String?
  source_last_modified DateTime?
  fetched_at           DateTime?

  // Cahier des charges — Architecture Data Universelle
  montant_max           String? // Montant max de l'aide (ex: "1500€")
  echelon_territorial   String? // "NATIONAL" | "REGIONAL" | "DEPARTEMENTAL" | "COMMUNAL"
  code_insee_territoire String? // vide si national, "44" Grand Est, "67000" Strasbourg
  lien_demarche         String? // URL directe pour candidater
  source_donnee         String? // "Aides-Territoires", "Scraping GrandEst", "OpenFisca", "DREES"

  // Traceability Fields (P1)
  retrieved_at    DateTime?
  last_checked_at DateTime?

  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([categoryId, statut])
  @@index([statut])
  @@index([source_document_id])
  @@index([category_code, status_code])
  @@index([status_code])
  @@index([source_hash])
  @@index([geo_scope])
  @@index([echelon_territorial])
  @@index([code_insee_territoire])
}

model AidCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  label     String
  aides     Aide[]
  demarches Demarche[] @relation("DemarcheToCategory")
}

model LifeSituation {
  id        String     @id @default(uuid())
  slug      String     @unique
  label     String
  aides     Aide[]     @relation("AideToLifeSituation")
  demarches Demarche[] @relation("DemarcheToSituation")
}

model Situation {
  id           String         @id @default(uuid())
  code         String         @unique
  label        String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  aidRelations AidSituation[]
}

model AidSituation {
  id          String    @id @default(uuid())
  aidId       String
  situationId String
  createdAt   DateTime  @default(now())
  aid         Aide      @relation(fields: [aidId], references: [id], onDelete: Cascade)
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)

  @@unique([aidId, situationId])
  @@index([situationId])
}

model AidSource {
  id            String    @id @default(uuid())
  name          String
  kind          String?
  baseUrl       String?
  license       String?
  refreshPolicy String?
  lastRunAt     DateTime?
  lastStatus    String?
  aides         Aide[]
}

model Structure {
  id                 String    @id @default(uuid())
  nom                String
  type_structure     String?
  accessibilite_pmr  Boolean   @default(false)
  description_courte String?
  adresse            String?
  code_postal        String?
  ville              String?
  departement        String?
  telephone          String?
  email              String?
  site_web           String?
  horaires           String?
  services           String[]
  publics_accueillis String[]
  date_verification  DateTime?
  categories_aidees  String[]
  updatedAt          DateTime  @updatedAt
  status             String    @default("actif")
  commentaire_statut String?
  published_at       DateTime?
  statut             String    @default("brouillon")
  updatedBy          String?
  mots_cles          String[]
  slug               String?   @unique
  summary_falc       String?
  is_pro_enabled     Boolean   @default(false)
  settings_json      Json?     @default("{}")
  auto_publish       Boolean   @default(false)
  geoloc_status      String?
  import_batch       String?
  import_status      String    @default("pending")
  last_sync          DateTime  @default(now())
  latitude           Float?
  longitude          Float?
  quality_score      Int       @default(50)
  raw_data_hash      String?   @unique
  siret              String?   @unique
  source_id          String?
  source_url         String?
  // Ingestion Fields
  source_url_exact   String?
  territory_scope    String? // NATIONAL | REGIONAL | DEPARTMENTAL | COMMUNAL
  region_codes       String[] // For REGIONAL scope
  department_codes   String[] // For DEPARTMENTAL scope
  insee_codes        String[] // For COMMUNAL scope
  content_hash       String?

  // Cahier des charges — Annuaire Universel
  type_finess     String? // Type FINESS (EHPAD, Hôpital, CMS, CCAS…)
  numero_finess   String? @unique // Identifiant national FINESS
  rna_id          String? @unique // Identifiant RNA pour les associations
  source_annuaire String? // "FINESS", "RNA", "OPENDATA_ALSACE", "ADMINISTRATION"

  // Traceability Fields (P1)
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?

  // Traceability
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  appointments     Appointment[]
  availabilities   Availability[]
  invitations      Invitation[]
  proUsers         ProUser[]
  proServices      Service[]
  proRdvServices   ProRdvService[]
  proRdvRules      ProAvailabilityRule[]
  proRdvSlots      ProAppointment[]
  proRdvTimeOffs   ProTimeOff[]
  rdvSettings      StructureRdvSettings?
  rdvConversations RdvConversation[]

  @@index([source_id])
  @@index([raw_data_hash])
  @@index([siret])
  @@index([statut, ville])
  @@index([departement])
  @@index([type_structure])
  @@index([statut, nom])
  @@index([source_document_id])
  @@index([numero_finess])
  @@index([rna_id])
  @@index([source_annuaire])
}

model Demarche {
  id                    String          @id @default(uuid())
  titre                 String
  categorie             String?
  description_courte    String?
  delai                 String?
  cout                  String?
  date_verification     DateTime?
  pour_qui              String?
  documents_necessaires String[]
  etapes                Json?
  ou_faire              String?
  lien_officiel         String?
  sources               Json?
  updatedAt             DateTime        @updatedAt
  statut                String          @default("brouillon")
  updatedBy             String?
  quality_score         Int             @default(0)
  commentaire_statut    String?
  published_at          DateTime?
  mots_cles             String[]
  slug                  String?         @unique
  summary_falc          String?
  audiences             String[]
  departements          String[]
  categoryId            String?
  category              AidCategory?    @relation("DemarcheToCategory", fields: [categoryId], references: [id])
  situations            LifeSituation[] @relation("DemarcheToSituation")

  // Cahier des charges — Démarches enrichies
  public_cible     String? // Public cible de la démarche
  contenu_detaille String? @db.Text // Contenu aspiré via Service-Public.fr
  lien_teleservice String? // Lien vers le téléservice en ligne

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String? // NATIONAL | REGIONAL | DEPARTMENTAL | COMMUNAL
  region_codes     String[] // For REGIONAL scope
  department_codes String[] // For DEPARTMENTAL scope
  insee_codes      String[] // For COMMUNAL scope
  content_hash     String?

  // Traceability Fields (P1)
  source_url           String?
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?

  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([categoryId, statut])
  @@index([statut])
  @@index([source_document_id])
}

model Actualite {
  id                 String          @id @default(uuid())
  titre              String
  contenu            String?
  date_publication   DateTime        @default(now())
  image_url          String?
  lien_url           String?
  source             String?
  updatedAt          DateTime        @updatedAt
  statut             String          @default("brouillon")
  updatedBy          String?
  commentaire_statut String?
  published_at       DateTime?
  canonical_url      String?         @unique
  category           String?         @default("actualite")
  dedupe_hash        String?
  fetched_at         DateTime?
  guid               String?
  key_points_falc    String[]
  slug               String?         @unique
  source_id          String?
  source_name        String?
  summary_falc       String?
  territoire         String?         @default("FRANCE")
  auto_publish       Boolean         @default(false)
  categorie          String?         @default("general")
  departements       String[]
  est_important      Boolean         @default(false)
  falc_status        String          @default("pending")
  ingest_batch       String?
  quality_score      Int             @default(0)
  raw_data_hash      String?         @unique
  raw_payload_json   Json?
  resume             String?
  score_fiabilite    Int             @default(0)
  source_nom         String?
  source_url         String?
  tags               String[]
  type_actu          String?         @default("info")
  url                String?
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([dedupe_hash])
  @@index([source_id])
  @@index([raw_data_hash])
  @@index([statut, date_publication])
  @@index([source_document_id])
}

model ImportLog {
  id            String   @id @default(uuid())
  run_id        String? // Unique run identifier for traceability
  source_name   String
  status        String
  items_total   Int      @default(0)
  items_new     Int      @default(0)
  items_updated Int      @default(0) // Track updates separately
  items_skipped Int      @default(0) // Track skipped items
  duration_ms   Int?
  logs          Json?
  error_count   Int      @default(0) // Track error count
  createdAt     DateTime @default(now())

  @@index([run_id])
  @@index([source_name, createdAt])
}

model CronRun {
  id          String    @id @default(cuid())
  job         String
  status      String // "running" | "success" | "failed" | "skipped"
  trigger     String? // "vercel" | "manual" | "external" | "unknown"
  skipReason  String? // "locked" | "cooldown"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  requestId   String?
  vercelEnv   String?
  release     String?
  metrics     Json?
  errorSample String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([job, startedAt])
  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

model ReviewQueueItem {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  entitySlug String?
  title      String?
  reason     String
  severity   String
  status     String
  details    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, reason, status])
  @@index([status, createdAt])
  @@index([entityType, status])
}

model RssSource {
  id            String    @id @default(uuid())
  name          String
  feed_url      String    @unique
  domain        String
  trust_level   String    @default("OFFICIAL")
  enabled       Boolean   @default(true)
  last_run_at   DateTime?
  etag          String?
  last_modified String?
  error_count   Int       @default(0)
  last_error    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UpdateLog {
  id                  Int      @id @default(autoincrement())
  ran_at              DateTime @default(now())
  status              String
  duration_ms         Int?
  items_fetched_count Int      @default(0)
  items_created_count Int      @default(0)
  items_updated_count Int      @default(0)
  items_skipped_count Int      @default(0)
  errors              String[]
  source_name         String?
  is_dry_run          Boolean  @default(false)
}

model IngestJob {
  id            String          @id @default(uuid())
  source        String
  status        IngestJobStatus @default(PENDING)
  payload       Json?
  result        Json?
  error_message String?
  started_at    DateTime?
  finished_at   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
}

model Source {
  id          String    @id @default(uuid())
  name        String
  type        String
  url         String?
  status      String    @default("actif")
  trust_level String?
  last_sync   DateTime?
}

model AdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  role                String    @default("admin")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lastLogin           DateTime?
  lockoutUntil        DateTime?
  // MFA TOTP (RFC 6238) — secret encrypted with AES-256-GCM via vault.js
  mfaSecret           String?   // Encrypted TOTP seed (ciphertext:authTag)
  mfaIv               String?   // Initialization vector (hex)
  mfaEnabled          Boolean   @default(false)
}

model CitizenUser {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  passwordHash             String
  emailVerifiedAt          DateTime?
  phone                    String?
  phoneVerifiedAt          DateTime?
  notificationEmailEnabled Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  authTokens               AuthToken[]
  proAppointments          ProAppointment[]         @relation("ProAppointmentCitizenUser")
  rdvConversations         RdvConversation[]
  rdvMessagesSent          RdvConversationMessage[] @relation("RdvMessageSenderCitizen")
}

model AuthToken {
  id        String      @id @default(uuid())
  userId    String
  type      String
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  user      CitizenUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  target    String?
  details   Json?
  timestamp DateTime @default(now())
  ip        String?
  actor_id  String?
  entity    String?
  entity_id String?
  ip_hash   String?
}

model ProUser {
  id                       String                   @id @default(uuid())
  email                    String
  password_hash            String
  role                     String
  status                   String                   @default("pending")
  structureId              String
  notificationEmailEnabled Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  appointments             Appointment[]
  availability             Availability[]
  proAppointmentsCreated   ProAppointment[]         @relation("ProAppointmentCreatedBy")
  rdvMessagesSent          RdvConversationMessage[] @relation("RdvMessageSenderPro")
  notifications            ProNotification[]
  outlookToken             ProOutlookToken?
  proAuditLogs             ProAuditLog[]
  structure                Structure                @relation(fields: [structureId], references: [id])

  // --- MFA (TOTP) ---
  mfa_enabled Boolean @default(false)
  mfa_secret  String?

  @@unique([structureId, email])
}

model Service {
  id               String        @id @default(uuid())
  structureId      String
  slug             String
  name             String
  description_falc String?
  duration_minutes Int?
  modes            Json?
  required_docs    String[]
  audiences        String[]
  is_active        Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[]
  structure        Structure     @relation(fields: [structureId], references: [id])

  @@unique([structureId, slug])
}

model ProRdvService {
  id                  String           @id @default(uuid())
  structureId         String
  name                String
  durationMinutes     Int
  bufferBeforeMinutes Int              @default(0)
  bufferAfterMinutes  Int              @default(0)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  appointments        ProAppointment[]
  structure           Structure        @relation(fields: [structureId], references: [id])

  @@index([structureId, isActive])
  @@index([structureId, updatedAt])
}

model ProAvailabilityRule {
  id          String    @id @default(uuid())
  structureId String
  weekday     Int
  startTime   String
  endTime     String
  timezone    String    @default("Europe/Paris")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  structure   Structure @relation(fields: [structureId], references: [id])

  @@index([structureId, weekday])
}

model ProAppointment {
  id                   String           @id @default(uuid())
  structureId          String
  serviceId            String
  startAt              DateTime
  endAt                DateTime
  status               String           @default("booked")
  beneficiaryName      String
  beneficiaryPhone     String?
  notes                String?
  createdByProUserId   String?
  citizenUserId        String?
  citizenEmailSnapshot String?
  idempotencyKey       String?
  cancelledAt          DateTime?
  cancelledBy          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdByProUser     ProUser?         @relation("ProAppointmentCreatedBy", fields: [createdByProUserId], references: [id], onDelete: SetNull)
  citizenUser          CitizenUser?     @relation("ProAppointmentCitizenUser", fields: [citizenUserId], references: [id], onDelete: SetNull)
  service              ProRdvService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  structure            Structure        @relation(fields: [structureId], references: [id], onDelete: Cascade)
  conversation         RdvConversation?

  // --- Visio (Jitsi) ---
  visioRoomId    String?
  visioEnabled   Boolean   @default(false)
  visioStartedAt DateTime?

  @@unique([citizenUserId, idempotencyKey])
  @@index([structureId, startAt])
  @@index([structureId, status, startAt])
  @@index([serviceId, startAt])
  @@index([citizenUserId, startAt])
}

model RdvConversation {
  id            String                   @id @default(uuid())
  appointmentId String                   @unique
  structureId   String
  citizenUserId String
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  appointment   ProAppointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  structure     Structure                @relation(fields: [structureId], references: [id], onDelete: Cascade)
  citizenUser   CitizenUser              @relation(fields: [citizenUserId], references: [id], onDelete: Cascade)
  messages      RdvConversationMessage[]
  notifications RdvNotificationLog[]

  @@index([structureId, lastMessageAt])
  @@index([citizenUserId, lastMessageAt])
}

model RdvConversationMessage {
  id                  String               @id @default(uuid())
  conversationId      String
  senderType          String
  senderCitizenUserId String?
  senderProUserId     String?
  body                String
  createdAt           DateTime             @default(now())
  conversation        RdvConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderCitizenUser   CitizenUser?         @relation("RdvMessageSenderCitizen", fields: [senderCitizenUserId], references: [id], onDelete: SetNull)
  senderProUser       ProUser?             @relation("RdvMessageSenderPro", fields: [senderProUserId], references: [id], onDelete: SetNull)
  notifications       RdvNotificationLog[]

  @@index([conversationId, createdAt])
  @@index([senderCitizenUserId])
  @@index([senderProUserId])
}

model RdvNotificationLog {
  id             String                 @id @default(uuid())
  kind           String                 @default("MESSAGE_EMAIL")
  conversationId String
  messageId      String
  recipientType  String
  sentAt         DateTime               @default(now())
  conversation   RdvConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        RdvConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientType])
  @@index([conversationId, sentAt])
}

model ProTimeOff {
  id          String    @id @default(uuid())
  structureId String
  startAt     DateTime
  endAt       DateTime
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId, startAt])
}

model StructureRdvSettings {
  id           String         @id @default(uuid())
  structureId  String         @unique
  isPublished  Boolean        @default(false)
  bookingMode  RdvBookingMode @default(IN_PERSON)
  contactEmail String?
  contactPhone String?
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  structure    Structure      @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([isPublished, updatedAt])
}

model Invitation {
  id          String    @id @default(uuid())
  structureId String
  email       String
  role        String
  token       String    @unique
  expires_at  DateTime
  used_at     DateTime?
  createdAt   DateTime  @default(now())
  structure   Structure @relation(fields: [structureId], references: [id])
}

model ConsentLog {
  id             String   @id @default(uuid())
  policy_version String
  policy_hash    String
  subject_type   String
  subject_id     String
  created_at     DateTime @default(now())
}

model Availability {
  id              String    @id @default(uuid())
  structureId     String
  proId           String?
  slots_json      Json      @default("{}")
  exceptions_json Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  pro             ProUser?  @relation(fields: [proId], references: [id])
  structure       Structure @relation(fields: [structureId], references: [id])

  @@unique([structureId, proId])
}

model Beneficiary {
  id                   String        @id @default(uuid())
  contact_encrypted    String
  contact_hash         String
  first_name_encrypted String?
  createdAt            DateTime      @default(now())
  appointments         Appointment[]

  @@index([contact_hash])
}

model Appointment {
  id                String      @id @default(uuid())
  structureId       String
  serviceId         String
  proId             String?
  beneficiaryId     String
  status            String      @default("requested")
  start_at          DateTime
  end_at            DateTime
  timezone          String      @default("Europe/Paris")
  mode              String
  lock_expires_at   DateTime?
  cancel_token_hash String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  access_token_hash String?
  metadata          Json?       @default("{}")
  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id])
  pro               ProUser?    @relation(fields: [proId], references: [id])
  service           Service     @relation(fields: [serviceId], references: [id])
  structure         Structure   @relation(fields: [structureId], references: [id])
  messages          Message[]

  @@index([structureId, start_at])
  @@index([proId, start_at])
  @@index([cancel_token_hash])
  @@index([access_token_hash])
  @@index([structureId, status, start_at])
}

model Message {
  id                String       @id @default(uuid())
  appointmentId     String
  sender            String
  content_encrypted String
  createdAt         DateTime     @default(now())
  read_at           DateTime?
  attachments       Attachment[]
  appointment       Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Attachment {
  id                 String   @id @default(uuid())
  messageId          String
  filename_encrypted String
  mime_type          String
  size_bytes         Int
  storage_key        String
  createdAt          DateTime @default(now())
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Guide {
  id           String    @id @default(uuid())
  slug         String    @unique
  titre        String
  resume_falc  String?
  contenu_json Json?
  categorie    String?
  publics      String[]
  contexte     String[]
  mots_cles    String[]
  sources_urls String[]
  statut       String    @default("brouillon")
  published_at DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([statut, published_at])
}

model ToolboxItem {
  id           String    @id @default(uuid())
  slug         String    @unique
  titre        String
  resume_falc  String?
  type         String
  categorie    String?
  publics      String[]
  url_download String?
  contenu_html String?
  statut       String    @default("brouillon")
  published_at DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([statut, published_at])
}

model PartnershipRequest {
  id            String   @id @default(uuid())
  structureName String
  city          String?
  type          String?
  website       String
  email         String
  message       String?
  status        String   @default("pending")
  consent       Boolean  @default(false)
  ip_hash       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EntityVersion {
  id            String   @id @default(uuid())
  entity_type   String
  entity_id     String
  snapshot_json Json
  reason        String?
  actor_email   String?
  createdAt     DateTime @default(now())

  @@index([entity_type, entity_id])
}

model Dispositif {
  id               String    @id @default(uuid())
  slug             String?   @unique
  titre            String
  description_falc String?
  public           String[]
  departement      String?
  montant          String?
  liens            Json?
  status           String    @default("actif")
  statut           String    @default("brouillon")
  published_at     DateTime?
  summary_falc     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String?
  content_hash     String?

  // Traceability Fields (P1)
  source_url           String?
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?

  // Traceability
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([source_document_id])
}

model SourceSnapshot {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  fetched_at   DateTime @default(now())
  raw_excerpt  String?
  content_hash String?
  http_status  Int?
  final_url    String?
  createdAt    DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([fetched_at])
}

model ResourceAccessibility {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  type            String
  content         String?
  source_url      String?
  territory_scope String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  status          String   @default("draft")

  // Traceability Fields (P1)
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?
}

enum ContentType {
  AIDE
  DEMARCHE
  STRUCTURE
  ACTUALITE
}

enum ReportReason {
  LIEN_MORT
  HORAIRES_FAUX
  INFO_FAUSSE
  INFO_OBSOLETE
  AUTRE
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  FIXED
  REJECTED
}

enum AidCategoryCode {
  LOGEMENT
  SANTE
  HANDICAP
  EMPLOI
  FAMILLE
  ETUDES
  MOBILITE
  ENERGIE
  ALIMENTATION
  JUSTICE
  NUMERIQUE
  AUTRE
}

enum AidStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IngestJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

enum RdvBookingMode {
  IN_PERSON
  VIDEO
  BOTH
}

model ContentReport {
  id            String       @id @default(cuid())
  contentType   ContentType
  contentId     String
  reason        ReportReason
  message       String?
  pageUrl       String?
  reporterEmail String?
  status        ReportStatus @default(NEW)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([contentType, contentId])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────
// Architecture Data Universelle — Phase 1
// ─────────────────────────────────────────────────────────

/// Tracks synchronisation runs for pipeline orchestration.
/// Fixes the runtime crash in ingest-structures.js which
/// referenced prisma.syncRun but had no backing model.
model SyncRun {
  id         String    @id @default(uuid())
  source_id  String? // "FINESS", "RNA", "STRUCTURES", etc.
  status     String // "running" | "success" | "partial" | "failed" | "skipped"
  started_at DateTime  @default(now())
  ended_at   DateTime?
  error      String?   @db.Text
  stats      Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, started_at])
  @@index([source_id, started_at])
}

// ---------------------------------------------------------
// MODÈLE LOGS CONVERSATIONS (Audit & Amélioration RAG)
// ---------------------------------------------------------

model ConversationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Contenu de l'échange (anonymisé)
  message String  @db.Text
  intent  String? // Intention détectée (ex: "logement", "rsa")

  // Métadonnées de performance RAG
  searchMode  String @default("rag") // "rag" | "lexical" | "static"
  sourceCount Int    @default(0) // Nombre d'aides trouvées

  // Session anonyme (optionnel)
  sessionId String?

  // Feedback usager (amélioration continue)
  rating      Int? // 1 (positif) ou -1 (négatif)
  userComment String? @db.Text // Commentaire optionnel sur la réponse

  @@index([createdAt])
  @@index([searchMode])
  @@index([rating])
}

// ---------------------------------------------------------
// MODÈLE DIAGNOSTICS PARTAGÉS (Lien de Partage)
// ---------------------------------------------------------

model SharedDiagnostic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime // Expiration automatique (7 jours par défaut)

  // Instantané du diagnostic (stocké en JSON natif PostgreSQL)
  situation Json // { birthDate, salary, rent, housingStatus, ... }
  results   Json // { rights: [...], period, meta }

  // Métadonnées de partage
  viewCount Int @default(0)

  @@index([createdAt])
  @@index([expiresAt])
}

// ── Pro Notifications ──
model ProNotification {
  id          String    @id @default(uuid())
  userId      String
  structureId String
  type        String // rdv_new, rdv_cancel, message_new, team_join, team_role_change, system
  title       String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  metadata    Json? // optional structured data (appointmentId, messageId, etc.)
  user        ProUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([structureId, createdAt])
}

model ProOutlookToken {
  id              String   @id @default(uuid())
  userId          String   @unique
  email           String?  // Email du compte Outlook lié
  accessTokenEnc  String   @db.Text // Chiffré AES-256-GCM
  refreshTokenEnc String   @db.Text // Chiffré AES-256-GCM
  iv              String   // Vecteur d'initialisation (hex)
  expiresAt       DateTime
  scope           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            ProUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// EXTENSION FINALE PHASE 2 — G2, G3/G4, G5
// -----------------------------------------------------------------------------

/// Traçabilité totale (G2) : Journal d'audit Pro par structure
model ProAuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  proUserId   String
  action      String // ex: "EXPORT_CSV", "INVITE_MEMBER", "DELETE_APPOINTMENT"
  entityType  String?
  entityId    String?
  metadata    Json? // Détails de l'action
  structureId String

  proUser ProUser @relation(fields: [proUserId], references: [id])

  @@index([structureId])
  @@index([proUserId, createdAt])
}

/// Messagerie persistante & chiffrée (G3/G4) : Messages chiffrés AES-256-GCM
model ProMessage {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  conversationId   String
  senderId         String // ID du Pro ou "CITIZEN"
  contentEncrypted String    @db.Text
  iv               String // Vecteur d'initialisation pour AES
  readAt           DateTime?

  @@index([conversationId])
  @@index([senderId, createdAt])
}

/// Consentement & Transparence (G5) : Accord RGPD avant consultation dossier
model UserConsent {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  citizenId   String
  structureId String
  purpose     String // ex: "DOSSIER_CONSULTATION"
  expiresAt   DateTime
  ipAddress   String?

  @@index([citizenId, structureId])
  @@index([expiresAt])
}
