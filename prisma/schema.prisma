generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SourceDocument {
  id           String   @id @default(uuid())
  source_url   String?
  fetched_at   DateTime @default(now())
  content_hash String?
  raw_content  String?
  metadata     Json?

  aides       Aide[]
  structures  Structure[]
  dispositifs Dispositif[]
  demarches   Demarche[]
  actualites  Actualite[]
}

model Aide {
  id                    String          @id @default(uuid())
  slug                  String?         @unique
  titre                 String
  categorie             String?
  est_urgent            Boolean         @default(false)
  territoires           String[]
  date_verification     DateTime?
  delai_indicatif       String?
  cest_quoi             String?
  pour_qui              String?
  ce_que_ca_aide        String?
  documents_necessaires String[]
  etapes                Json?
  ou_demander           String?
  lien_demande          String?
  updatedAt             DateTime        @updatedAt
  statut                String          @default("brouillon")
  updatedBy             String?
  quality_score         Int             @default(0)
  commentaire_statut    String?
  published_at          DateTime?
  mots_cles             String[]
  summary_falc          String?
  audiences             String[]
  conditions_falc       String?
  departements          String[]
  montant_falc          String?
  situations_vie        String[]
  structures_links      String[]
  categoryId            String?
  providerName          String?
  providerType          String?
  sourceId              String?
  source_name           String?
  source_url            String?
  category              AidCategory?    @relation(fields: [categoryId], references: [id])
  source                AidSource?      @relation(fields: [sourceId], references: [id])
  situations            LifeSituation[] @relation("AideToLifeSituation")
  aidSituations         AidSituation[]

  // AI Foundation Fields (P0/P1)
  title         String?
  description   String?
  content       String?
  category_code AidCategoryCode             @default(AUTRE)
  status_code   AidStatus                   @default(DRAFT)
  eligibility   Json?
  financials    Json?
  citations     Json?
  qa_score      Int                         @default(0)
  qa_report     Json?
  source_org    String?
  source_hash   String?
  last_checked  DateTime?
  geo_scope     String?
  embedding     Unsupported("vector(768)")?
  ts_content    Unsupported("tsvector")?

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String? // NATIONAL | REGIONAL | DEPARTMENTAL | COMMUNAL
  region_codes     String[] // For REGIONAL scope
  department_codes String[] // For DEPARTMENTAL scope
  insee_codes      String[] // For COMMUNAL scope
  content_hash     String?

  // New Standard Fields (Lot 9a)
  theme                String?
  sub_theme            String?
  apply_url            String?
  source_last_modified DateTime?
  fetched_at           DateTime?

  // Traceability Fields (P1)
  retrieved_at    DateTime?
  last_checked_at DateTime?

  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([categoryId, statut])
  @@index([statut])
  @@index([source_document_id])
  @@index([category_code, status_code])
  @@index([status_code])
  @@index([source_hash])
  @@index([geo_scope])
}

model AidCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  label     String
  aides     Aide[]
  demarches Demarche[] @relation("DemarcheToCategory")
}

model LifeSituation {
  id        String     @id @default(uuid())
  slug      String     @unique
  label     String
  aides     Aide[]     @relation("AideToLifeSituation")
  demarches Demarche[] @relation("DemarcheToSituation")
}

model Situation {
  id           String         @id @default(uuid())
  code         String         @unique
  label        String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  aidRelations AidSituation[]
}

model AidSituation {
  id          String    @id @default(uuid())
  aidId       String
  situationId String
  createdAt   DateTime  @default(now())
  aid         Aide      @relation(fields: [aidId], references: [id], onDelete: Cascade)
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)

  @@unique([aidId, situationId])
  @@index([situationId])
}

model AidSource {
  id            String    @id @default(uuid())
  name          String
  kind          String?
  baseUrl       String?
  license       String?
  refreshPolicy String?
  lastRunAt     DateTime?
  lastStatus    String?
  aides         Aide[]
}

model Structure {
  id                 String    @id @default(uuid())
  nom                String
  type_structure     String?
  accessibilite_pmr  Boolean   @default(false)
  description_courte String?
  adresse            String?
  code_postal        String?
  ville              String?
  departement        String?
  telephone          String?
  email              String?
  site_web           String?
  horaires           String?
  services           String[]
  publics_accueillis String[]
  date_verification  DateTime?
  categories_aidees  String[]
  updatedAt          DateTime  @updatedAt
  status             String    @default("actif")
  commentaire_statut String?
  published_at       DateTime?
  statut             String    @default("brouillon")
  updatedBy          String?
  mots_cles          String[]
  slug               String?   @unique
  summary_falc       String?
  is_pro_enabled     Boolean   @default(false)
  settings_json      Json?     @default("{}")
  auto_publish       Boolean   @default(false)
  geoloc_status      String?
  import_batch       String?
  import_status      String    @default("pending")
  last_sync          DateTime  @default(now())
  latitude           Float?
  longitude          Float?
  quality_score      Int       @default(50)
  raw_data_hash      String?   @unique
  siret              String?   @unique
  source_id          String?
  source_url         String?
  // Ingestion Fields
  source_url_exact   String?
  territory_scope    String? // NATIONAL | REGIONAL | DEPARTMENTAL | COMMUNAL
  region_codes       String[] // For REGIONAL scope
  department_codes   String[] // For DEPARTMENTAL scope
  insee_codes        String[] // For COMMUNAL scope
  content_hash       String?

  // Traceability Fields (P1)
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?

  // Traceability
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  appointments   Appointment[]
  availabilities Availability[]
  invitations    Invitation[]
  proUsers       ProUser[]
  proServices    Service[]
  proRdvServices ProRdvService[]
  proRdvRules    ProAvailabilityRule[]
  proRdvSlots    ProAppointment[]
  proRdvTimeOffs ProTimeOff[]

  @@index([source_id])
  @@index([raw_data_hash])
  @@index([siret])
  @@index([statut, ville])
  @@index([departement])
  @@index([type_structure])
  @@index([statut, nom])
  @@index([source_document_id])
}

model Demarche {
  id                    String          @id @default(uuid())
  titre                 String
  categorie             String?
  description_courte    String?
  delai                 String?
  cout                  String?
  date_verification     DateTime?
  pour_qui              String?
  documents_necessaires String[]
  etapes                Json?
  ou_faire              String?
  lien_officiel         String?
  sources               Json?
  updatedAt             DateTime        @updatedAt
  statut                String          @default("brouillon")
  updatedBy             String?
  quality_score         Int             @default(0)
  commentaire_statut    String?
  published_at          DateTime?
  mots_cles             String[]
  slug                  String?         @unique
  summary_falc          String?
  audiences             String[]
  departements          String[]
  categoryId            String?
  category              AidCategory?    @relation("DemarcheToCategory", fields: [categoryId], references: [id])
  situations            LifeSituation[] @relation("DemarcheToSituation")

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String? // NATIONAL | REGIONAL | DEPARTMENTAL | COMMUNAL
  region_codes     String[] // For REGIONAL scope
  department_codes String[] // For DEPARTMENTAL scope
  insee_codes      String[] // For COMMUNAL scope
  content_hash     String?

  // Traceability Fields (P1)
  source_url           String?
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?

  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([categoryId, statut])
  @@index([statut])
  @@index([source_document_id])
}

model Actualite {
  id                 String    @id @default(uuid())
  titre              String
  contenu            String?
  date_publication   DateTime  @default(now())
  image_url          String?
  lien_url           String?
  source             String?
  updatedAt          DateTime  @updatedAt
  statut             String    @default("brouillon")
  updatedBy          String?
  commentaire_statut String?
  published_at       DateTime?
  canonical_url      String?   @unique
  category           String?   @default("actualite")
  dedupe_hash        String?
  fetched_at         DateTime?
  guid               String?
  key_points_falc    String[]
  slug               String?   @unique
  source_id          String?
  source_name        String?
  summary_falc       String?
  territoire         String?   @default("FRANCE")
  auto_publish       Boolean   @default(false)
  categorie          String?   @default("general")
  departements       String[]
  est_important      Boolean   @default(false)
  falc_status        String    @default("pending")
  ingest_batch       String?
  quality_score      Int       @default(0)
  raw_data_hash      String?   @unique
  raw_payload_json   Json?
  resume             String?
  score_fiabilite    Int       @default(0)
  source_nom         String?
  source_url         String?
  tags               String[]
  type_actu          String?   @default("info")
  url                String?
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([dedupe_hash])
  @@index([source_id])
  @@index([raw_data_hash])
  @@index([statut, date_publication])
  @@index([source_document_id])
}

model ImportLog {
  id            String   @id @default(uuid())
  run_id        String? // Unique run identifier for traceability
  source_name   String
  status        String
  items_total   Int      @default(0)
  items_new     Int      @default(0)
  items_updated Int      @default(0) // Track updates separately
  items_skipped Int      @default(0) // Track skipped items
  duration_ms   Int?
  logs          Json?
  error_count   Int      @default(0) // Track error count
  createdAt     DateTime @default(now())

  @@index([run_id])
  @@index([source_name, createdAt])
}

model CronRun {
  id          String   @id @default(cuid())
  job         String
  status      String // "running" | "success" | "failed" | "skipped"
  trigger     String? // "vercel" | "manual" | "external" | "unknown"
  skipReason  String? // "locked" | "cooldown"
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  requestId   String?
  vercelEnv   String?
  release     String?
  metrics     Json?
  errorSample String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([job, startedAt])
  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

model ReviewQueueItem {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  entitySlug String?
  title      String?
  reason     String
  severity   String
  status     String
  details    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([entityType, status])
  @@unique([entityType, entityId, reason, status])
}

model RssSource {
  id            String    @id @default(uuid())
  name          String
  feed_url      String    @unique
  domain        String
  trust_level   String    @default("OFFICIAL")
  enabled       Boolean   @default(true)
  last_run_at   DateTime?
  etag          String?
  last_modified String?
  error_count   Int       @default(0)
  last_error    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UpdateLog {
  id                  Int      @id @default(autoincrement())
  ran_at              DateTime @default(now())
  status              String
  duration_ms         Int?
  items_fetched_count Int      @default(0)
  items_created_count Int      @default(0)
  items_updated_count Int      @default(0)
  items_skipped_count Int      @default(0)
  errors              String[]
  source_name         String?
  is_dry_run          Boolean  @default(false)
}

model IngestJob {
  id            String          @id @default(uuid())
  source        String
  status        IngestJobStatus @default(PENDING)
  payload       Json?
  result        Json?
  error_message String?
  started_at    DateTime?
  finished_at   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
}

model Source {
  id          String    @id @default(uuid())
  name        String
  type        String
  url         String?
  status      String    @default("actif")
  trust_level String?
  last_sync   DateTime?
}

model AdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  role                String    @default("admin")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lastLogin           DateTime?
  lockoutUntil        DateTime?
}

model CitizenUser {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  authTokens      AuthToken[]
}

model AuthToken {
  id        String      @id @default(uuid())
  userId    String
  type      String
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  user      CitizenUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  target    String?
  details   Json?
  timestamp DateTime @default(now())
  ip        String?
  actor_id  String?
  entity    String?
  entity_id String?
  ip_hash   String?
}

model ProUser {
  id            String         @id @default(uuid())
  email         String
  password_hash String
  role          String
  status        String         @default("pending")
  structureId   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  availability  Availability[]
  proAppointmentsCreated ProAppointment[] @relation("ProAppointmentCreatedBy")
  structure     Structure      @relation(fields: [structureId], references: [id])

  @@unique([structureId, email])
}

model Service {
  id               String        @id @default(uuid())
  structureId      String
  slug             String
  name             String
  description_falc String?
  duration_minutes Int?
  modes            Json?
  required_docs    String[]
  audiences        String[]
  is_active        Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[]
  structure        Structure     @relation(fields: [structureId], references: [id])

  @@unique([structureId, slug])
}

model ProRdvService {
  id                  String           @id @default(uuid())
  structureId         String
  name                String
  durationMinutes     Int
  bufferBeforeMinutes Int              @default(0)
  bufferAfterMinutes  Int              @default(0)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  appointments        ProAppointment[]
  structure           Structure        @relation(fields: [structureId], references: [id])

  @@index([structureId, isActive])
  @@index([structureId, updatedAt])
}

model ProAvailabilityRule {
  id         String    @id @default(uuid())
  structureId String
  weekday    Int
  startTime  String
  endTime    String
  timezone   String    @default("Europe/Paris")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  structure  Structure @relation(fields: [structureId], references: [id])

  @@index([structureId, weekday])
}

model ProAppointment {
  id                 String         @id @default(uuid())
  structureId        String
  serviceId          String
  startAt            DateTime
  endAt              DateTime
  status             String         @default("booked")
  beneficiaryName    String
  beneficiaryPhone   String?
  notes              String?
  createdByProUserId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdByProUser   ProUser?       @relation("ProAppointmentCreatedBy", fields: [createdByProUserId], references: [id], onDelete: SetNull)
  service            ProRdvService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  structure          Structure       @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId, startAt])
  @@index([structureId, status, startAt])
  @@index([serviceId, startAt])
}

model ProTimeOff {
  id         String    @id @default(uuid())
  structureId String
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  structure  Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId, startAt])
}

model Invitation {
  id          String    @id @default(uuid())
  structureId String
  email       String
  role        String
  token       String    @unique
  expires_at  DateTime
  used_at     DateTime?
  createdAt   DateTime  @default(now())
  structure   Structure @relation(fields: [structureId], references: [id])
}

model ConsentLog {
  id             String   @id @default(uuid())
  policy_version String
  policy_hash    String
  subject_type   String
  subject_id     String
  created_at     DateTime @default(now())
}

model Availability {
  id              String    @id @default(uuid())
  structureId     String
  proId           String?
  slots_json      Json      @default("{}")
  exceptions_json Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  pro             ProUser?  @relation(fields: [proId], references: [id])
  structure       Structure @relation(fields: [structureId], references: [id])

  @@unique([structureId, proId])
}

model Beneficiary {
  id                   String        @id @default(uuid())
  contact_encrypted    String
  contact_hash         String
  first_name_encrypted String?
  createdAt            DateTime      @default(now())
  appointments         Appointment[]

  @@index([contact_hash])
}

model Appointment {
  id                String      @id @default(uuid())
  structureId       String
  serviceId         String
  proId             String?
  beneficiaryId     String
  status            String      @default("requested")
  start_at          DateTime
  end_at            DateTime
  timezone          String      @default("Europe/Paris")
  mode              String
  lock_expires_at   DateTime?
  cancel_token_hash String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  access_token_hash String?
  metadata          Json?       @default("{}")
  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id])
  pro               ProUser?    @relation(fields: [proId], references: [id])
  service           Service     @relation(fields: [serviceId], references: [id])
  structure         Structure   @relation(fields: [structureId], references: [id])
  messages          Message[]

  @@index([structureId, start_at])
  @@index([proId, start_at])
  @@index([cancel_token_hash])
  @@index([access_token_hash])
  @@index([structureId, status, start_at])
}

model Message {
  id                String       @id @default(uuid())
  appointmentId     String
  sender            String
  content_encrypted String
  createdAt         DateTime     @default(now())
  read_at           DateTime?
  attachments       Attachment[]
  appointment       Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Attachment {
  id                 String   @id @default(uuid())
  messageId          String
  filename_encrypted String
  mime_type          String
  size_bytes         Int
  storage_key        String
  createdAt          DateTime @default(now())
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Guide {
  id           String    @id @default(uuid())
  slug         String    @unique
  titre        String
  resume_falc  String?
  contenu_json Json?
  categorie    String?
  publics      String[]
  contexte     String[]
  mots_cles    String[]
  sources_urls String[]
  statut       String    @default("brouillon")
  published_at DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([statut, published_at])
}

model ToolboxItem {
  id           String    @id @default(uuid())
  slug         String    @unique
  titre        String
  resume_falc  String?
  type         String
  categorie    String?
  publics      String[]
  url_download String?
  contenu_html String?
  statut       String    @default("brouillon")
  published_at DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([statut, published_at])
}

model PartnershipRequest {
  id            String   @id @default(uuid())
  structureName String
  city          String?
  type          String?
  website       String
  email         String
  message       String?
  status        String   @default("pending")
  consent       Boolean  @default(false)
  ip_hash       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EntityVersion {
  id            String   @id @default(uuid())
  entity_type   String
  entity_id     String
  snapshot_json Json
  reason        String?
  actor_email   String?
  createdAt     DateTime @default(now())

  @@index([entity_type, entity_id])
}

model Dispositif {
  id               String    @id @default(uuid())
  slug             String?   @unique
  titre            String
  description_falc String?
  public           String[]
  departement      String?
  montant          String?
  liens            Json?
  status           String    @default("actif")
  statut           String    @default("brouillon")
  published_at     DateTime?
  summary_falc     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String?
  content_hash     String?

  // Traceability Fields (P1)
  source_url           String?
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?

  // Traceability
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([source_document_id])
}

model SourceSnapshot {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  fetched_at   DateTime @default(now())
  raw_excerpt  String?
  content_hash String?
  http_status  Int?
  final_url    String?
  createdAt    DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([fetched_at])
}

model ResourceAccessibility {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  type            String
  content         String?
  source_url      String?
  territory_scope String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  status          String   @default("draft")

  // Traceability Fields (P1)
  retrieved_at         DateTime?
  last_checked_at      DateTime?
  source_last_modified DateTime?
}

enum ContentType {
  AIDE
  DEMARCHE
  STRUCTURE
  ACTUALITE
}

enum ReportReason {
  LIEN_MORT
  HORAIRES_FAUX
  INFO_FAUSSE
  INFO_OBSOLETE
  AUTRE
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  FIXED
  REJECTED
}

enum AidCategoryCode {
  LOGEMENT
  SANTE
  HANDICAP
  EMPLOI
  FAMILLE
  ETUDES
  MOBILITE
  ENERGIE
  ALIMENTATION
  JUSTICE
  NUMERIQUE
  AUTRE
}

enum AidStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IngestJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

model ContentReport {
  id            String       @id @default(cuid())
  contentType   ContentType
  contentId     String
  reason        ReportReason
  message       String?
  pageUrl       String?
  reporterEmail String?
  status        ReportStatus @default(NEW)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([contentType, contentId])
  @@index([status, createdAt])
}
