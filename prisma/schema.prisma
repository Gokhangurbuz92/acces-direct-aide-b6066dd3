generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Aide {
  id                    String          @id @default(uuid())
  slug                  String?         @unique
  titre                 String
  categorie             String?
  est_urgent            Boolean         @default(false)
  territoires           String[]
  date_verification     DateTime?
  delai_indicatif       String?
  cest_quoi             String?
  pour_qui              String?
  ce_que_ca_aide        String?
  documents_necessaires String[]
  etapes                Json?
  ou_demander           String?
  lien_demande          String?
  updatedAt             DateTime        @updatedAt
  statut                String          @default("brouillon")
  updatedBy             String?
  quality_score         Int             @default(0)
  commentaire_statut    String?
  published_at          DateTime?
  mots_cles             String[]
  summary_falc          String?
  audiences             String[]
  conditions_falc       String?
  departements          String[]
  montant_falc          String?
  situations_vie        String[]
  structures_links      String[]
  categoryId            String?
  providerName          String?
  providerType          String?
  sourceId              String?
  source_name           String?
  source_url            String?
  category              AidCategory?    @relation(fields: [categoryId], references: [id])
  source                AidSource?      @relation(fields: [sourceId], references: [id])
  situations            LifeSituation[] @relation("AideToLifeSituation")

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String?
  content_hash     String?

  // New Standard Fields (Lot 9a)
  theme                 String?
  sub_theme             String?
  apply_url             String?
  source_last_modified  DateTime?
  fetched_at            DateTime?
  
  // Traceability Fields (P1)
  retrieved_at          DateTime?
  last_checked_at       DateTime?

  // Additional fields for complete data model
  organisme             String?
  territoire_niveau     String?
  territoire_label      String?
  montant               String?
  avantage              String?
  contacts              Json?
  falc_steps            String?
  source_domain         String?

  @@index([statut, published_at])
  @@index([categoryId, statut])
  @@index([statut])
  @@index([source_document_id])
}

model AidCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  label     String
  aides     Aide[]
  demarches Demarche[] @relation("DemarcheToCategory")
}

model LifeSituation {
  id        String     @id @default(uuid())
  slug      String     @unique
  label     String
  aides     Aide[]     @relation("AideToLifeSituation")
  demarches Demarche[] @relation("DemarcheToSituation")
}

model AidSource {
  id            String    @id @default(uuid())
  name          String
  kind          String?
  baseUrl       String?
  license       String?
  refreshPolicy String?
  lastRunAt     DateTime?
  lastStatus    String?
  aides         Aide[]
}

model Structure {
  id                 String    @id @default(uuid())
  nom                String
  type_structure     String?
  accessibilite_pmr  Boolean   @default(false)
  description_courte String?
  adresse            String?
  code_postal        String?
  ville              String?
  departement        String?
  telephone          String?
  email              String?
  site_web           String?
  horaires           String?
  services           String[]
  publics_accueillis String[]
  date_verification  DateTime?
  categories_aidees  String[]
  updatedAt          DateTime  @updatedAt
  status             String    @default("actif")
  commentaire_statut String?
  published_at       DateTime?
  statut             String    @default("brouillon")
  updatedBy          String?
  mots_cles          String[]
  slug               String?   @unique
  summary_falc       String?
  is_pro_enabled     Boolean   @default(false)
  settings_json      Json?     @default("{}")
  auto_publish       Boolean   @default(false)
  geoloc_status      String?
  import_batch       String?
  import_status      String    @default("pending")
  last_sync          DateTime  @default(now())
  latitude           Float?
  longitude          Float?
  quality_score      Int       @default(50)
  raw_data_hash      String?   @unique
  siret              String?   @unique
  source_id          String?
  source_url         String?
  // Ingestion Fields
  source_url_exact   String?
  territory_scope    String?
  content_hash       String?
  
  // Traceability Fields (P1)
  retrieved_at          DateTime?
  last_checked_at       DateTime?
  source_last_modified  DateTime?

  // Traceability
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  appointments   Appointment[]
  availabilities Availability[]
  invitations    Invitation[]
  proUsers       ProUser[]
  proServices    Service[]

  @@index([source_id])
  @@index([raw_data_hash])
  @@index([siret])
  @@index([statut, ville])
  @@index([departement])
  @@index([type_structure])
  @@index([statut, nom])
  @@index([source_document_id])
}

model Demarche {
  id                    String          @id @default(uuid())
  titre                 String
  categorie             String?
  description_courte    String?
  delai                 String?
  cout                  String?
  date_verification     DateTime?
  pour_qui              String?
  documents_necessaires String[]
  etapes                Json?
  ou_faire              String?
  lien_officiel         String?
  sources               Json?
  updatedAt             DateTime        @updatedAt
  statut                String          @default("brouillon")
  updatedBy             String?
  quality_score         Int             @default(0)
  commentaire_statut    String?
  published_at          DateTime?
  mots_cles             String[]
  slug                  String?         @unique
  summary_falc          String?
  audiences             String[]
  departements          String[]
  categoryId            String?
  category              AidCategory?    @relation("DemarcheToCategory", fields: [categoryId], references: [id])
  situations            LifeSituation[] @relation("DemarcheToSituation")

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String?
  content_hash     String?

  
  // Traceability Fields (P1)
  source_url            String?
  retrieved_at          DateTime?
  last_checked_at       DateTime?
  source_last_modified  DateTime?

  @@index([statut, published_at])
  @@index([categoryId, statut])
  @@index([statut])
  @@index([source_document_id])
}

model Actualite {
  id                 String    @id @default(uuid())
  titre              String
  contenu            String?
  date_publication   DateTime  @default(now())
  image_url          String?
  lien_url           String?
  source             String?
  updatedAt          DateTime  @updatedAt
  statut             String    @default("brouillon")
  updatedBy          String?
  commentaire_statut String?
  published_at       DateTime?
  canonical_url      String?   @unique
  category           String?   @default("actualite")
  dedupe_hash        String?
  fetched_at         DateTime?
  guid               String?
  key_points_falc    String[]
  slug               String?   @unique
  source_id          String?
  source_name        String?
  summary_falc       String?
  territoire         String?   @default("FRANCE")
  auto_publish       Boolean   @default(false)
  categorie          String?   @default("general")
  departements       String[]
  est_important      Boolean   @default(false)
  falc_status        String    @default("pending")
  ingest_batch       String?
  quality_score      Int       @default(0)
  raw_data_hash      String?   @unique
  raw_payload_json   Json?
  resume             String?
  score_fiabilite    Int       @default(0)
  source_nom         String?
  source_url         String?
  tags               String[]
  type_actu          String?   @default("info")
  url                String?

  @@index([dedupe_hash])
  @@index([source_id])
  @@index([raw_data_hash])
  @@index([statut, date_publication])
}

model ImportLog {
  id            String   @id @default(uuid())
  run_id        String?  // Unique run identifier for traceability
  source_name   String
  status        String
  items_total   Int      @default(0)
  items_new     Int      @default(0)
  items_updated Int      @default(0) // Track updates separately
  items_skipped Int      @default(0) // Track skipped items
  duration_ms   Int?
  logs          Json?
  error_count   Int      @default(0) // Track error count
  createdAt     DateTime @default(now())
  
  @@index([run_id])
  @@index([source_name, createdAt])
}

model RssSource {
  id            String    @id @default(uuid())
  name          String
  feed_url      String    @unique
  domain        String
  trust_level   String    @default("OFFICIAL")
  enabled       Boolean   @default(true)
  last_run_at   DateTime?
  etag          String?
  last_modified String?
  error_count   Int       @default(0)
  last_error    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UpdateLog {
  id                  Int      @id @default(autoincrement())
  ran_at              DateTime @default(now())
  status              String
  duration_ms         Int?
  items_fetched_count Int      @default(0)
  items_created_count Int      @default(0)
  items_updated_count Int      @default(0)
  items_skipped_count Int      @default(0)
  errors              String[]
  source_name         String?
  is_dry_run          Boolean  @default(false)
}

model Source {
  id          String    @id @default(uuid())
  name        String
  type        String
  url         String?
  status      String    @default("actif")
  trust_level String?
  last_sync   DateTime?
}

model AdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  role                String    @default("admin")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lastLogin           DateTime?
  lockoutUntil        DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String?
  target    String?
  details   Json?
  timestamp DateTime @default(now())
  ip        String?
  actor_id  String?
  entity    String?
  entity_id String?
  ip_hash   String?
}

model ProUser {
  id            String         @id @default(uuid())
  email         String
  password_hash String
  role          String
  status        String         @default("pending")
  structureId   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  availability  Availability[]
  structure     Structure      @relation(fields: [structureId], references: [id])

  @@unique([structureId, email])
}

model Service {
  id               String        @id @default(uuid())
  structureId      String
  slug             String
  name             String
  description_falc String?
  duration_minutes Int?
  modes            Json?
  required_docs    String[]
  audiences        String[]
  is_active        Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[]
  structure        Structure     @relation(fields: [structureId], references: [id])

  @@unique([structureId, slug])
}

model Invitation {
  id          String    @id @default(uuid())
  structureId String
  email       String
  role        String
  token       String    @unique
  expires_at  DateTime
  used_at     DateTime?
  createdAt   DateTime  @default(now())
  structure   Structure @relation(fields: [structureId], references: [id])
}

model ConsentLog {
  id             String   @id @default(uuid())
  policy_version String
  policy_hash    String
  subject_type   String
  subject_id     String
  created_at     DateTime @default(now())
}

model Availability {
  id              String    @id @default(uuid())
  structureId     String
  proId           String?
  slots_json      Json      @default("{}")
  exceptions_json Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  pro             ProUser?  @relation(fields: [proId], references: [id])
  structure       Structure @relation(fields: [structureId], references: [id])

  @@unique([structureId, proId])
}

model Beneficiary {
  id                   String        @id @default(uuid())
  contact_encrypted    String
  contact_hash         String
  first_name_encrypted String?
  createdAt            DateTime      @default(now())
  appointments         Appointment[]

  @@index([contact_hash])
}

model Appointment {
  id                String      @id @default(uuid())
  structureId       String
  serviceId         String
  proId             String?
  beneficiaryId     String
  status            String      @default("requested")
  start_at          DateTime
  end_at            DateTime
  timezone          String      @default("Europe/Paris")
  mode              String
  lock_expires_at   DateTime?
  cancel_token_hash String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  access_token_hash String?
  metadata          Json?       @default("{}")
  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id])
  pro               ProUser?    @relation(fields: [proId], references: [id])
  service           Service     @relation(fields: [serviceId], references: [id])
  structure         Structure   @relation(fields: [structureId], references: [id])
  messages          Message[]

  @@index([structureId, start_at])
  @@index([proId, start_at])
  @@index([cancel_token_hash])
  @@index([access_token_hash])
  @@index([structureId, status, start_at])
}

model Message {
  id                String       @id @default(uuid())
  appointmentId     String
  sender            String
  content_encrypted String
  createdAt         DateTime     @default(now())
  read_at           DateTime?
  attachments       Attachment[]
  appointment       Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Attachment {
  id                 String   @id @default(uuid())
  messageId          String
  filename_encrypted String
  mime_type          String
  size_bytes         Int
  storage_key        String
  createdAt          DateTime @default(now())
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Guide {
  id           String    @id @default(uuid())
  slug         String    @unique
  titre        String
  resume_falc  String?
  contenu_json Json?
  categorie    String?
  publics      String[]
  contexte     String[]
  mots_cles    String[]
  sources_urls String[]
  statut       String    @default("brouillon")
  published_at DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([statut, published_at])
}

model ToolboxItem {
  id           String    @id @default(uuid())
  slug         String    @unique
  titre        String
  resume_falc  String?
  type         String
  categorie    String?
  publics      String[]
  url_download String?
  contenu_html String?
  statut       String    @default("brouillon")
  published_at DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([statut, published_at])
}

model PartnershipRequest {
  id            String   @id @default(uuid())
  structureName String
  city          String?
  type          String?
  website       String
  email         String
  message       String?
  status        String   @default("pending")
  consent       Boolean  @default(false)
  ip_hash       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EntityVersion {
  id            String   @id @default(uuid())
  entity_type   String
  entity_id     String
  snapshot_json Json
  reason        String?
  actor_email   String?
  createdAt     DateTime @default(now())

  @@index([entity_type, entity_id])
}

model Dispositif {
  id               String    @id @default(uuid())
  slug             String?   @unique
  titre            String
  description_falc String?
  public           String[]
  departement      String?
  montant          String?
  liens            Json?
  status           String    @default("actif")
  statut           String    @default("brouillon")
  published_at     DateTime?
  summary_falc     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Ingestion Fields
  source_url_exact String?
  territory_scope  String?
  content_hash     String?
  
  // Traceability Fields (P1)
  source_url            String?
  retrieved_at          DateTime?
  last_checked_at       DateTime?
  source_last_modified  DateTime?

  // Traceability
  source_document_id String?
  sourceDocument     SourceDocument? @relation(fields: [source_document_id], references: [id])

  @@index([statut, published_at])
  @@index([source_document_id])
}

model SourceSnapshot {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  fetched_at   DateTime @default(now())
  raw_excerpt  String?
  content_hash String?
  http_status  Int?
  final_url    String?
  createdAt    DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([fetched_at])
}

model ResourceAccessibility {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  type            String
  content         String?
  source_url      String?
  territory_scope String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  status          String   @default("draft")
  
  // Traceability Fields (P1)
  retrieved_at          DateTime?
  last_checked_at       DateTime?
  source_last_modified  DateTime?
}
