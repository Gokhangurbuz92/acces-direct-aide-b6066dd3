{
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "regions": ["fra1"],
      "includeFiles": "api/**/*.{js,ts},src/db/**/*.{js,ts}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/actualites",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/ingest-aids",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ingest-structures",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/ingest-demarches",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/review-queue/scan",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/ingest-annuaire",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/hive-scan",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/rdv-reminder",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/backup-db",
      "schedule": "0 1 * * 0"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "accesdirectaide.fr"
        }
      ],
      "destination": "https://www.accesdirectaide.fr/:path*",
      "permanent": true
    },
    {
      "source": "/(.+)/",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/guide/:slug",
      "destination": "/demarches",
      "permanent": true
    },
    {
      "source": "/aide/:slug",
      "destination": "/aides/:slug",
      "permanent": true
    },
    {
      "source": "/login/pro",
      "destination": "/pro/login",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/structures",
      "destination": "/annuaire",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/__dev/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|@vite/|@react-refresh|@fs/|@id/|__vite_ping|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Ji1RDZFcXHYwXORx2Mz2R71m8j2Y73X371QJqvYvIHQ=' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.service-public.fr https://api.accesdirectaide.fr https://*.ingest.sentry.io https://*.vercel-analytics.com; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
        }
      ]
    }
  ]
}